<!DOCTYPE html>
<html lang="ru">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>GREEN-API Dashboard</title>
    <link href="https://jsdelivr.net" rel="stylesheet">
    <style>
        body { background-color: #f8f9fa; padding: 20px; }
        .card { margin-bottom: 20px; }
        pre { background: #e9ecef; padding: 10px; border-radius: 5px; max-height: 300px; overflow-y: auto; }
    </style>
</head>
<body>

<div class="container">
    <h2 class="mb-4">Управление GREEN-API</h2>

    <!-- Настройки -->
    <div class="card">
        <div class="card-body">
            <h5 class="card-title">Авторизация инстанса</h5>
            <div class="row g-3">
                <div class="col-md-6">
                    <label for="idInstance" class="form-label">idInstance</label>
                    <input type="text" class="form-control" id="7107628485" placeholder="1101234567">
                </div>
                <div class="col-md-6">
                    <label for="apiTokenInstance" class="form-label">apiTokenInstance</label>
                    <input type="text" class="form-control" id="2415fc38bd1a4857b5c1b17c49b723b69b38c1a3abef4b1687" placeholder="your_api_token_here">
                </div>
            </div>
        </div>
    </div>

    <!-- Методы -->
    <div class="row">
        <!-- 1. getSettings -->
        <div class="col-md-6">
            <div class="card">
                <div class="card-body">
                    <h5 class="card-title">getSettings</h5>
                    <p class="card-text">Получить текущие настройки инстанса.</p>
                    <button class="btn btn-primary" onclick="getSettings()">Вызвать</button>
                    <pre id="resultSettings" class="mt-3 d-none"></pre>
                </div>
            </div>
        </div>

        <!-- 2. getStateInstance -->
        <div class="col-md-6">
            <div class="card">
                <div class="card-body">
                    <h5 class="card-title">getStateInstance</h5>
                    <p class="card-text">Получить статус подключения инстанса.</p>
                    <button class="btn btn-primary" onclick="getStateInstance()">Вызвать</button>
                    <pre id="resultState" class="mt-3 d-none"></pre>
                </div>
            </div>
        </div>
    </div>

    <div class="row">
        <!-- 3. sendMessage -->
        <div class="col-md-6">
            <div class="card">
                <div class="card-body">
                    <h5 class="card-title">sendMessage</h5>
                    <p class="card-text">Отправить текстовое сообщение.</p>
                    <div class="mb-2">
                        <input type="text" class="form-control" id="msgChatId" placeholder="chatId (например, 79991234567@c.us)">
                    </div>
                    <div class="mb-2">
                        <input type="text" class="form-control" id="msgText" placeholder="Текст сообщения">
                    </div>
                    <button class="btn btn-success" onclick="sendMessage()">Отправить</button>
                    <pre id="resultMsg" class="mt-3 d-none"></pre>
                </div>
            </div>
        </div>

        <!-- 4. sendFileByUrl -->
        <div class="col-md-6">
            <div class="card">
                <div class="card-body">
                    <h5 class="card-title">sendFileByUrl</h5>
                    <p class="card-text">Отправить файл по прямой ссылке.</p>
                    <div class="mb-2">
                        <input type="text" class="form-control" id="fileChatId" placeholder="chatId (например, 79991234567@c.us)">
                    </div>
                    <div class="mb-2">
                        <input type="text" class="form-control" id="fileUrl" placeholder="URL файла (прямая ссылка)">
                    </div>
                    <div class="mb-2">
                        <input type="text" class="form-control" id="fileName" placeholder="Имя файла (с расширением)">
                    </div>
                    <button class="btn btn-success" onclick="sendFileByUrl()">Отправить файл</button>
                    <pre id="resultFile" class="mt-3 d-none"></pre>
                </div>
            </div>
        </div>
    </div>
</div>

<script>
    const API_URL = 'https://api.green-api.com';

    function getCredentials() {
        const idInstance = document.getElementById('idInstance').value.trim();
        const apiTokenInstance = document.getElementById('apiTokenInstance').value.trim();
        if (!idInstance || !apiTokenInstance) {
            alert('Пожалуйста, заполните idInstance и apiTokenInstance.');
            return null;
        }
        return { idInstance, apiTokenInstance };
    }

    function showResult(elementId, data) {
        const pre = document.getElementById(elementId);
        pre.textContent = JSON.stringify(data, null, 2);
        pre.classList.remove('d-none');
    }

    async function getSettings() {
        const creds = getCredentials();
        if (!creds) return;
        try {
            const response = await fetch(`${API_URL}/waInstance${creds.idInstance}/getSettings/${creds.apiTokenInstance}`);
            const data = await response.json();
            showResult('resultSettings', data);
        } catch (error) {
            showResult('resultSettings', { error: error.message });
        }
    }

    async function getStateInstance() {
        const creds = getCredentials();
        if (!creds) return;
        try {
            const response = await fetch(`${API_URL}/waInstance${creds.idInstance}/getStateInstance/${creds.apiTokenInstance}`);
            const data = await response.json();
            showResult('resultState', data);
        } catch (error) {
            showResult('resultState', { error: error.message });
        }
    }

    async function sendMessage() {
        const creds = getCredentials();
        if (!creds) return;
        const chatId = document.getElementById('msgChatId').value.trim();
        const message = document.getElementById('msgText').value.trim();
        
        try {
            const response = await fetch(`${API_URL}/waInstance${creds.idInstance}/sendMessage/${creds.apiTokenInstance}`, {
                method: 'POST',
                headers: { 'Content-Type': 'application/json' },
                body: JSON.stringify({ chatId, message })
            });
            const data = await response.json();
            showResult('resultMsg', data);
        } catch (error) {
            showResult('resultMsg', { error: error.message });
        }
    }

    async function sendFileByUrl() {
        const creds = getCredentials();
        if (!creds) return;
        const chatId = document.getElementById('fileChatId').value.trim();
        const urlFile = document.getElementById('fileUrl').value.trim();
        const fileName = document.getElementById('fileName').value.trim();

        try {
            const response = await fetch(`${API_URL}/waInstance${creds.idInstance}/sendFileByUrl/${creds.apiTokenInstance}`, {
                method: 'POST',
                headers: { 'Content-Type': 'application/json' },
                body: JSON.stringify({ chatId, urlFile, fileName, caption: '' })
            });
            const data = await response.json();
            showResult('resultFile', data);
        } catch (error) {
            showResult('resultFile', { error: error.message });
        }
    }
</script>

</body>
</html>
